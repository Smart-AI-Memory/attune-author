__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
/MANIFEST
/MANIFEST.in

# Unit test / coverage reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# uv
.uv/

# Local tooling state (Claude Code plans, attune project index, coverage)
# Ignore .claude/ cruft (plans, worktrees, settings.local.json) but track
# the vendored session hooks + their wiring (see specs/sibling-claude-hooks/).
.claude/*
!.claude/hooks/
!.claude/settings.json
.attune/
coverage.json
.env
.mcp.json
